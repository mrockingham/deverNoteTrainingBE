generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// =========================
/// CORE APP MODELS
/// =========================

model User {
  id                 String   @id @default(uuid())
  name               String
  userName           String?  @unique
  email              String   @unique
  password           String?
  theme              String   @default("code dark")
  hasProvider        Boolean  @default(false)
  provider           String?
  providerId         String?  @unique
  userImage          String?
  userImageId        String?
  bio                String?
  aiCreditsRemaining Int      @default(5)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Existing app relations
  codeBlocks      CodeBlock[]
  projects        Project[]
  sandboxSessions SandboxSession[]

  // Learning platform relations
  lessonPlans      LessonPlan[]
  practiceSessions PracticeSession[]
  stepAttempts     StepAttempt[]
}

model Theme {
  id                 String   @id @default(uuid())
  name               String   @unique
  foregroundText     String?
  gradient           Boolean  @default(false)
  boxShadows         Boolean  @default(false)
  backgroundText     String?
  boxShadowSettings  String[]
  backgroundSolid    String?
  backgroundGradient String[]
}

model UtilityLink {
  id          String  @id @default(uuid())
  siteName    String
  siteUrl     String
  type        String
  imageUrl    String?
  linkImageId String?
}

/// =========================
/// SNIPPETS / SCRATCHPAD
/// =========================

model CodeBlock {
  id           String   @id @default(uuid())
  title        String
  creatorId    String
  category     String
  subCategory  String?
  javascript   String?
  css          String?
  html         String?
  note         String?
  tags         String[]
  isPublic     Boolean  @default(false)
  favorites    String[]
  sourceType   String   @default("manual") // manual, lesson_step, generated
  lessonPlanId String?
  lessonStepId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [creatorId], references: [id])
  lessonPlan LessonPlan? @relation(fields: [lessonPlanId], references: [id])
  lessonStep LessonStep? @relation(fields: [lessonStepId], references: [id])

  @@index([creatorId])
  @@index([lessonPlanId])
  @@index([lessonStepId])
}

/// =========================
/// PROJECTS / SANDPACK
/// =========================

model Project {
  id          String   @id @default(uuid())
  title       String
  creatorId   String
  description String?
  isPublic    Boolean  @default(false)
  files       Json
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
}

/// =========================
/// LESSON PLANNING
/// =========================

model LessonPlan {
  id               String   @id @default(uuid())
  creatorId        String
  title            String
  topic            String
  level            String
  framework        String
  focus            String?
  notes            String?
  description      String?
  sourcePrompt     String?
  aiSummary        String?
  status           String   @default("draft") // draft, published, archived
  isPublic         Boolean  @default(false)
  sandpackTemplate String? // react-ts, react, vanilla, etc.
  dependencies     Json? // { "framer-motion": "latest" }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  creator         User              @relation(fields: [creatorId], references: [id])
  steps           LessonStep[]
  sessions        PracticeSession[]
  codeBlocks      CodeBlock[]
  sandboxSessions SandboxSession[]

  @@index([creatorId])
  @@index([status])
}

/// =========================
/// LESSON STEPS
/// =========================

model LessonStep {
  id                String   @id @default(uuid())
  lessonPlanId      String
  orderIndex        Int
  phaseTitle        String?
  title             String
  description       String
  instructions      Json // array of step instructions
  hints             Json? // array of hints
  scaffoldFiles     Json? // optional partially-complete version
  starterFiles      Json? // optional user starting point
  solutionFiles     Json // expected end state
  verificationRules Json? // deterministic rule config
  snippetExports    Json? // optional snippet metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lessonPlan      LessonPlan       @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  attempts        StepAttempt[]
  codeBlocks      CodeBlock[]
  sandboxSessions SandboxSession[]

  @@unique([lessonPlanId, orderIndex])
  @@index([lessonPlanId])
}

/// =========================
/// PRACTICE SESSIONS
/// =========================

model PracticeSession {
  id           String    @id @default(uuid())
  userId       String
  lessonPlanId String
  currentStep  Int       @default(0)
  currentRep   Int       @default(1)
  bestRep      Int       @default(0)
  totalReps    Int       @default(0)
  status       String    @default("active") // active, paused, completed, abandoned
  startedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlan      LessonPlan       @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  attempts        StepAttempt[]
  sandboxSessions SandboxSession[]

  @@index([userId])
  @@index([lessonPlanId])
  @@index([status])
}

/// =========================
/// STEP ATTEMPTS / REPETITION
/// =========================

model StepAttempt {
  id                String    @id @default(uuid())
  userId            String
  lessonStepId      String
  practiceSessionId String?
  repNumber         Int
  submittedFiles    Json
  normalizedFiles   Json?
  passed            Boolean   @default(false)
  score             Int?
  feedback          Json? // AI or rule feedback
  aiDiffUsed        Boolean   @default(false)
  hintsUsed         Int       @default(0)
  startedAt         DateTime  @default(now())
  submittedAt       DateTime?
  createdAt         DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonStep      LessonStep       @relation(fields: [lessonStepId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([lessonStepId])
  @@index([practiceSessionId])
  @@index([repNumber])
}

model SandboxSession {
  id                String   @id @default(uuid())
  userId            String
  title             String?
  description       String?
  sandpackTemplate  String?
  dependencies      Json?
  files             Json
  sourceType        String   @default("manual") // manual, lesson, practice
  status            String   @default("active") // active, archived, completed
  lessonPlanId      String?
  lessonStepId      String?
  practiceSessionId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlan      LessonPlan?      @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)
  lessonStep      LessonStep?      @relation(fields: [lessonStepId], references: [id], onDelete: SetNull)
  practiceSession PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([lessonPlanId])
  @@index([lessonStepId])
  @@index([practiceSessionId])
  @@index([status])
}
